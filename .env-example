# chromatic-crew — environment template
# No API key is required: the crew runs on local Ollama (free).
#
# OPTIONAL — to switch the engine to Anthropic Claude, set provider="anthropic"
# in config/models.json and provide a key here:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
#
# Ollama endpoint (default shown):
OLLAMA_BASE_URL=http://localhost:11434
